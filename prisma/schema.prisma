// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // หรือประเภทฐานข้อมูลที่คุณใช้อยู่
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  username       String
  passwordHash   String
  role           Role            @default(USER)
  notificationEmail String?         // <--- เพิ่มบรรทัดนี้: เก็บอีเมลสำหรับแจ้งเตือนโดยเฉพาะ
  createdAt      DateTime        @default(now())
  profile        Profile?
  children       Child[]
  appointments   Appointment[]
  vaccineRecords VaccineRecord[]
  vaccineRequests VaccineRequest[]
  pushSubscriptions WebPushSubscription[]
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Profile {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  gender    String?
  weight    Float?
  height    Float?
  dob       DateTime?
  updatedAt DateTime  @updatedAt
}

model Child {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  gender         String?
  weight         Float?
  height         Float?
  dob            DateTime?
  appointments   Appointment[]
  vaccineRecords VaccineRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

// ------------------------------------------------------
// [เพิ่มใหม่] 1. ตารางเก็บข้อมูลสถานพยาบาล
// ------------------------------------------------------
model Hospital {
  id           String         @id @default(uuid())
  name         String // ชื่อโรงพยาบาล
  address      String? // ที่อยู่
  latitude     Float? // พิกัดละติจูด (สำหรับคำนวณ GPS)
  longitude    Float? // พิกัดลองจิจูด (สำหรับคำนวณ GPS)
  slots        HospitalSlot[] // เชื่อมกับตารางเวลาคิวว่าง
  appointments Appointment[] // เชื่อมกับประวัติการจองของ User
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ------------------------------------------------------
// [เพิ่มใหม่] 2. ตารางเก็บวันและเวลาว่างของแต่ละโรงพยาบาล
// ------------------------------------------------------
model HospitalSlot {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date       DateTime // วันที่เปิดรับคิว
  time       String // ช่วงเวลา เช่น "09:00", "13:30"
  capacity   Int      @default(10) // จำนวนคิวที่รับได้ในเวลานั้น (เต็มแล้วซ่อน)
  booked     Int      @default(0) // จำนวนคิวที่ถูกจองไปแล้ว
  isClosed   Boolean  @default(false)
  isAdminDefined Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hospitalId, date, time]) // ป้องกันไม่ให้สร้างคิวเวลาซ้ำกันในวันเดียวกัน
}

model Appointment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId       String
  child         Child     @relation(fields: [childId], references: [id], onDelete: Restrict)
  hospitalId    String?
  hospital      Hospital? @relation(fields: [hospitalId], references: [id])
  hospitalName  String
  scheduledAt   DateTime
  requestedVaccine String?   // <--- เพิ่มบรรทัดนี้ (เพื่อเก็บชื่อวัคซีนที่ผู้ใช้เลือก)
  notified7Days Boolean   @default(false)
  notified3Days Boolean   @default(false)
  notified1Day  Boolean   @default(false)
  notified1Hour Boolean  @default(false)
  status        String    @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, EXPIRED, RESCHEDULED
  isWaitlisted  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VaccineRecord {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId            String
  child              Child           @relation(fields: [childId], references: [id], onDelete: Restrict)
  vaccineCatalogId   String?
  vaccineCatalog     VaccineCatalog? @relation(fields: [vaccineCatalogId], references: [id], onDelete: SetNull)
  vaccineName        String
  vaccineCode        String?
  administeredDate   DateTime
  hospitalName       String
  source             String
  verificationStatus String          @default("PENDING")
  createdAt          DateTime        @default(now())
}

model VaccineCatalog {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  stock     Int             @default(0)
  isActive  Boolean         @default(true)
  records   VaccineRecord[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, name])
}
// 1. นำโค้ดนี้ไปต่อท้ายสุดของไฟล์ prisma/schema.prisma
model VaccineRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedName String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
